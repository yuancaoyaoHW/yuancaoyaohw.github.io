---
/**
 * /about/ — site about page.
 * Real, restrained, professional copy. No fabricated affiliations, titles,
 * awards, or contact details. Only references what is verifiably on this site
 * and the public GitHub account.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const SITE = 'https://yuancaoyaohw.github.io';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: '关于本站',
  description: 'AI Infra 个人知识站:深度文章、每日论文、电子书与交互式技术讲解。',
  url: `${SITE}/about/`,
};
---
<BaseLayout
  pageType="other"
  activeMore="about"
  title="关于本站"
  description="AI Infra 个人知识站:深度文章、每日论文、电子书与交互式技术讲解。"
  canonical="/about/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <section class="archive-hero">
    <div class="section-inner">
      <span class="eyebrow">About</span>
      <h1>关于本站</h1>
      <p class="archive-lede">这是一个专注 AI Infra 的个人知识站,以可长期维护的形式发布深度技术文章、每日论文精选、电子书与交互式技术讲解。</p>
    </div>
  </section>

  <section class="section" style="padding-top:32px;">
    <div class="section-inner narrow">
      <div class="about-block">
        <p class="section-label">关注方向</p>
        <ul class="about-list">
          <li>LLM Serving</li>
          <li>GPU / CUDA</li>
          <li>KV Cache</li>
          <li>Speculative Decoding</li>
          <li>推理优化</li>
          <li>AI Infra</li>
        </ul>
      </div>

      <div class="about-block">
        <p class="section-label">内容形式</p>
        <ul class="about-list">
          <li>深度文章 — 对单篇论文或技术的系统解读,含源码对照与工程视角。</li>
          <li>每日论文 — AI Infra / Algorithms / Architecture 三频道每日精选。</li>
          <li>电子书 — GPU 编程、凸优化等系统化阅读内容,站内可在线阅读。</li>
          <li>交互式技术讲解 — 含 SVG 动画与数学公式的可操作技术文章。</li>
        </ul>
      </div>

      <div class="about-block">
        <p class="section-label">每日论文筛选方式</p>
        <p class="about-text">
          每日论文由自动化流程从 arXiv 与 HuggingFace 抓取候选,经评审打分后筛选 score≥4 的论文。覆盖 AI Infra、Algorithms、Architecture 三个频道,目标是过滤噪音、保留对 AI Infra 工程有参考价值的工作。
        </p>
      </div>

      <div class="about-block">
        <p class="section-label">电子书项目</p>
        <p class="about-text">
          电子书包括站内 Starlight 维护的《Modern GPU Programming For MLSys》中文翻译,以及外部维护的《Convex Optimization》中英对照翻译。详见<a href="/books/">电子书总览</a>。
        </p>
      </div>

      <div class="about-block">
        <p class="section-label">项目与链接</p>
        <ul class="about-list">
          <li><a href="https://github.com/yuancaoyaoHW">GitHub</a> — 源码与电子书项目仓库</li>
          <li><a href="/books/">电子书</a> — 站内与外部电子书总览</li>
          <li><a href="/blog/">深度文章归档</a> — 全部技术文章</li>
          <li><a href="/papers/">每日论文归档</a> — 历史日报</li>
        </ul>
      </div>

      <div class="about-block">
        <p class="section-label">联系方式</p>
        <p class="about-text">
          通过 <a href="https://github.com/yuancaoyaoHW">GitHub</a> 联系。本站不公开其他联系方式。
        </p>
      </div>
    </div>
  </section>

  <style is:global>
    .about-block { margin-bottom: 40px; }
    .about-list {
      list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px;
    }
    .about-list li {
      font-size: 16px; line-height: 1.6; color: var(--text); padding-left: 20px; position: relative;
    }
    .about-list li::before {
      content: ""; position: absolute; left: 0; top: 10px;
      width: 6px; height: 6px; border-radius: 50%; background: var(--orange);
    }
    .about-list a { color: var(--link); }
    .about-list a:hover { text-decoration: underline; }
    .about-text { font-size: 16px; line-height: 1.7; color: var(--text); }
    .about-text a { color: var(--link); }
    .about-text a:hover { text-decoration: underline; }
  </style>
</BaseLayout>
