---
/**
 * /books/ — ebook library overview.
 * Uses SiteLayout (= BaseLayout). Lists all books with title, description,
 * status, chapter count, reading entry, and site/external distinction.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/BookCard.astro';
import { getBooks } from '../../data/content.ts';

const books = await getBooks();
---
<BaseLayout
  pageType="books"
  title="电子书"
  description="围绕 GPU、机器学习系统、优化和 AI Infra 的系统化阅读内容。"
  canonical="/books/"
>
  <section class="archive-hero">
    <div class="section-inner">
      <span class="eyebrow">Book Library · {books.length} 本</span>
      <h1>电子书</h1>
      <p class="archive-lede">围绕 GPU、机器学习系统、优化和 AI Infra 的系统化阅读内容。站内电子书可在线阅读,外部项目可访问源站。</p>
    </div>
  </section>

  <section class="section" style="padding-top:32px;">
    <div class="section-inner">
      <div class="post-list">
        {books.map((book) => <BookCard book={book} />)}
      </div>
    </div>
  </section>
</BaseLayout>
