---
/**
 * /blog/interview-qa/ — 面经归档页。
 *
 * 这条路由必须单独写：/blog/[slug] 的 getStaticPaths 只枚举 posts 集合，
 * 而面经在 interviews 集合里，所以导航「更多 → 面经」和页脚链接此前都是 404。
 * Astro 静态路由优先于动态路由，两者不冲突。
 *
 * 正文是一整页自带目录/搜索的长文，走 InteractiveArticleLayout，
 * 剥离规则与 /blog/[slug] 共用 extractArticleHtml()。
 */
import { getInterviews } from '../../data/content.ts';
import { extractArticleHtml } from '../../data/article-html.ts';
import InteractiveArticleLayout from '../../layouts/InteractiveArticleLayout.astro';

const interviews = await getInterviews();
const post = interviews.find((i) => i.data.slug === 'interview-qa');
if (!post) throw new Error('缺少 src/content/interviews/interview-qa.json');

const { headHtml, bodyHtml } = extractArticleHtml('src/articles/blog/interview-qa/index.html');
---

<InteractiveArticleLayout
  post={post}
  headHtml={headHtml}
  bodyHtml={bodyHtml}
  activeMore="interview"
/>
