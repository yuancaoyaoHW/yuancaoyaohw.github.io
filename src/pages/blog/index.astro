---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompactPostRow from '../../components/CompactPostRow.astro';
import { getPostsByYear, getAllTags } from '../../data/content.ts';

const postsByYear = await getPostsByYear();
const allTags = await getAllTags();
const totalPosts = postsByYear.reduce((s, y) => s + y.posts.length, 0);
---
<BaseLayout
  pageType="blog"
  title="深度文章"
  description="AI Infra、LLM 推理、GPU 优化与系统技术的深度解读文章归档。"
  canonical="/blog/"
>
  <!-- Compact Archive Hero -->
  <section class="archive-hero">
    <div class="section-inner">
      <span class="eyebrow">Article Archive · {totalPosts} 篇</span>
      <h1>深度文章</h1>
      <p class="archive-lede">关于 LLM Serving、GPU、KV Cache、推测解码与系统优化的技术文章。</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="section-inner wide">
      <!-- Filter bar -->
      <div class="filter-bar">
        <input type="text" id="search-filter" placeholder="按标题或关键词筛选…" aria-label="筛选文章" />
        <select id="tag-filter" aria-label="按标签筛选">
          <option value="">全部标签</option>
          {allTags.map((t) => <option value={t.tag}>{t.tag} ({t.count})</option>)}
        </select>
        <button class="filter-clear" id="clear-filters" type="button">清除</button>
      </div>

      <div id="post-count" style="font-size:13px;color:var(--text-muted);margin-bottom:16px;font-family:var(--font-display);">
        共 {totalPosts} 篇
      </div>

      <!-- Year-grouped archive -->
      <div id="archive">
        {postsByYear.map((yg, idx) => (
          <div class="year-group" data-year={yg.year} data-collapsed={idx === 0 ? undefined : ''}>
            <h2>
              {yg.year}
              <span class="year-count">{yg.posts.length} 篇</span>
              <button class="year-toggle" aria-label={`切换 ${yg.year} 年折叠`}></button>
            </h2>
            <div class="year-items">
              {yg.posts.map((post) => <CompactPostRow post={post} />)}
            </div>
          </div>
        ))}
      </div>

      <!-- Empty state -->
      <div class="empty-state" id="empty-state" style="display:none;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <p>没有匹配的文章。试试清除筛选条件。</p>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var searchInput = document.getElementById('search-filter');
      var tagSelect = document.getElementById('tag-filter');
      var clearBtn = document.getElementById('clear-filters');
      var countEl = document.getElementById('post-count');
      var emptyEl = document.getElementById('empty-state');
      var groups = Array.from(document.querySelectorAll('.year-group'));

      function applyFilter() {
        var q = searchInput.value.trim().toLowerCase();
        var tag = tagSelect.value;
        var visibleTotal = 0;
        groups.forEach(function (g) {
          var rows = Array.from(g.querySelectorAll('.compact-row'));
          var yearVisible = 0;
          rows.forEach(function (r) {
            var title = r.querySelector('.row-title') ? r.querySelector('.row-title').textContent.toLowerCase() : '';
            var tags = r.querySelector('.row-tags') ? r.querySelector('.row-tags').textContent.toLowerCase() : '';
            var matchQ = !q || title.indexOf(q) !== -1 || tags.indexOf(q) !== -1;
            var matchTag = !tag || tags.indexOf(tag.toLowerCase()) !== -1;
            var show = matchQ && matchTag;
            r.style.display = show ? '' : 'none';
            if (show) yearVisible++;
          });
          g.style.display = yearVisible > 0 ? '' : 'none';
          visibleTotal += yearVisible;
        });
        countEl.textContent = visibleTotal > 0 ? '共 ' + visibleTotal + ' 篇' : '无匹配文章';
        emptyEl.style.display = visibleTotal > 0 ? 'none' : '';
      }

      var debounce;
      searchInput.addEventListener('input', function () {
        clearTimeout(debounce);
        debounce = setTimeout(applyFilter, 150);
      });
      tagSelect.addEventListener('change', applyFilter);
      clearBtn.addEventListener('click', function () {
        searchInput.value = '';
        tagSelect.value = '';
        applyFilter();
        searchInput.focus();
      });

      // Year toggle
      groups.forEach(function (g) {
        var h2 = g.querySelector('h2');
        h2.addEventListener('click', function () {
          if (g.hasAttribute('data-collapsed')) g.removeAttribute('data-collapsed');
          else g.setAttribute('data-collapsed', '');
        });
      });

      applyFilter();
    })();
  </script>
</BaseLayout>
