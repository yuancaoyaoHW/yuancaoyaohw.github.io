---
/**
 * /blog/[slug]/ — unified blog detail page.
 * Reads metadata from the `posts` collection and the article body from the
 * standalone HTML at public/blog/<slug>/index.html. Strips injected nav
 * (data-sn-* blocks, old footer, old theme scripts) so the page uses the
 * unified BaseLayout chrome via ArticleLayout / InteractiveArticleLayout.
 */
import { getPublishedPosts, type Post } from '../../data/content.ts';
import { extractArticleHtml } from '../../data/article-html.ts';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import InteractiveArticleLayout from '../../layouts/InteractiveArticleLayout.astro';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

interface Props { post: Post }
const { post } = Astro.props;
const slug = post.data.slug;

const { headHtml, bodyHtml, found } = extractArticleHtml(`src/articles/blog/${slug}/index.html`);
const body = found
  ? bodyHtml
  : `<div class="external-notice"><p>本文发布在外部站点。</p><a class="btn btn-primary" href="${post.data.externalHref || '#'}">访问原文 →</a></div>`;

const isInteractive = post.data.hasAnimation;
---

{isInteractive ? (
  <InteractiveArticleLayout post={post} headHtml={headHtml} bodyHtml={body} />
) : (
  <ArticleLayout post={post} headHtml={headHtml} bodyHtml={body} />
)}

<style is:global>
  .external-notice { max-width: 560px; margin: 80px auto; text-align: center; padding: 48px 24px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--panel); }
  .external-notice p { font-size: 17px; color: var(--text); margin-bottom: 24px; }
  .external-notice .btn-primary { display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; border-radius: var(--radius); background: var(--link); color: var(--on-brand); font-family: var(--font-display); font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; }
</style>
