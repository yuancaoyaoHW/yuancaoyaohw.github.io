---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import PostCard from '../components/PostCard.astro';
import PaperDigestCard from '../components/PaperDigestCard.astro';
import BookCard from '../components/BookCard.astro';
import TopicChip from '../components/TopicChip.astro';
import {
  getFeaturedPosts, getLatestPosts, getLatestPaper,
  getBooks, getInterviews, getTravelGuides, TOPICS, getPostsForTopic,
} from '../data/content.ts';

const featured = await getFeaturedPosts();
const latest = await getLatestPosts(6);
const latestPaper = await getLatestPaper();
const books = await getBooks();
const interviews = await getInterviews();
const travelGuides = await getTravelGuides();

// Topic counts (precompute)
const topicCounts = await Promise.all(
  TOPICS.map(async (t) => ({ topic: t, count: (await getPostsForTopic(t)).length }))
);
---
<BaseLayout
  pageType="home"
  title=""
  description="深入理解 LLM 推理、Serving、GPU Kernel 与系统优化。深度技术文章、每日论文精选与电子书。"
  canonical="/"
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <span class="eyebrow">AI Infra · LLM Serving · GPU Optimization</span>
      <h1>AI Infra Blogs</h1>
      <p class="lede">深入理解 LLM 推理、Serving、GPU Kernel 与系统优化。深度技术文章、每日论文精选与电子书，以可长期维护的知识站形式发布。</p>
      <div class="hero-actions">
        <a href="/blog/" class="btn btn-primary">
          开始阅读
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <button class="btn btn-ghost" id="search-trigger-hero" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
          搜索全站
        </button>
        <a href="https://github.com/yuancaoyaoHW" class="btn btn-ghost">GitHub</a>
      </div>
    </div>
  </section>

  <!-- Featured reading -->
  {featured.length > 0 && (
    <section class="section" id="featured">
      <div class="section-inner">
        <p class="section-label">推荐阅读</p>
        <div class="post-list">
          {featured.map((post) => <FeaturedCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Latest deep articles (max 6) -->
  <section class="section" id="latest">
    <div class="section-inner">
      <p class="section-label">
        最新深度文章
        <a href="/blog/" class="see-all">查看全部 →</a>
      </p>
      <div class="post-list">
        {latest.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <!-- Paper radar (latest issue only) -->
  {latestPaper && (
    <section class="section" id="papers">
      <div class="section-inner">
        <p class="section-label">
          每日论文雷达
          <a href="/papers/" class="see-all">历史日报 →</a>
        </p>
        <PaperDigestCard paper={latestPaper} />
        <p style="margin-top:16px;font-size:13px;color:var(--text-muted);font-family:var(--font-display);">
          每日 AI Infra / Algorithms / Architecture 三频道自动抓取,score≥4 论文精选。
        </p>
      </div>
    </section>
  )}

  <!-- Books -->
  <section class="section" id="books">
    <div class="section-inner">
      <p class="section-label">电子书</p>
      <div class="post-list">
        {books.map((book) => <BookCard book={book} />)}
      </div>
    </div>
  </section>

  <!-- Topics -->
  <section class="section" id="topics">
    <div class="section-inner">
      <p class="section-label">按主题探索</p>
      <div class="topic-grid">
        {topicCounts.map(({ topic, count }) => (
          <TopicChip slug={topic.slug} label={topic.label} count={count} description={topic.description} />
        ))}
      </div>
    </div>
  </section>

  <!-- Minor content (interviews + travel, compact) -->
  <section class="section" id="more">
    <div class="section-inner">
      <p class="section-label">更多内容</p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:32px;">
        <div>
          <p style="font-family:var(--font-display);font-size:14px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:14px;">面经</p>
          <div class="post-list">
            {interviews.map((i) => (
              <a class="card" href={`/blog/${i.data.slug}/`} data-type="面经" style="padding:16px 20px;">
                <span class="card-title" style="font-size:16px;">{i.data.title}</span>
                <span class="card-meta"><span>{i.data.publishedDate}</span></span>
              </a>
            ))}
          </div>
        </div>
        <div>
          <p style="font-family:var(--font-display);font-size:14px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:14px;">旅行</p>
          <div class="post-list">
            {travelGuides.map((t) => (
              <a class="card" href={`/travel/${t.data.slug}.html`} data-type="旅行" style="padding:16px 20px;">
                <span class="card-title" style="font-size:16px;">{t.data.title}</span>
                <span class="card-meta"><span>{t.data.publishedDate}</span></span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
