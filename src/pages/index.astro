---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import PostCard from '../components/PostCard.astro';
import PaperDigestCard from '../components/PaperDigestCard.astro';
import BookCard from '../components/BookCard.astro';
import TopicChip from '../components/TopicChip.astro';
import {
  getFeaturedPosts, getLatestPosts, getLatestPaper,
  getBooks, getInterviews, getTravelGuides, TOPICS, getPostsForTopic,
} from '../data/content.ts';

const featured = await getFeaturedPosts();
const latest = await getLatestPosts(6);
const latestPaper = await getLatestPaper();
const books = await getBooks();
const interviews = await getInterviews();
const travelGuides = await getTravelGuides();

// Topic counts (precompute)
const topicCounts = await Promise.all(
  TOPICS.map(async (t) => ({ topic: t, count: (await getPostsForTopic(t)).length }))
);
---
<BaseLayout
  pageType="home"
  title=""
  description="深入理解 LLM 推理、Serving、GPU Kernel 与系统优化。深度技术文章、每日论文精选与电子书。"
  canonical="/"
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-eyebrow">AI INFRA · LLM SERVING · GPU SYSTEMS</p>

      <h1 class="hero-title">AI Infra, Explained.</h1>

      <p class="hero-description">
        深入拆解 LLM 推理、Serving、KV Cache 与 GPU Kernel，把复杂系统讲清楚。
      </p>

      <div class="hero-actions">
        <a href="/blog/" class="hero-btn hero-btn--primary" data-action="read">
          开始阅读
          <svg class="hero-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <button class="hero-btn hero-btn--secondary" id="search-trigger-hero" type="button" aria-label="搜索文章">
          <svg class="hero-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
          搜索文章
        </button>
        <a href="https://github.com/yuancaoyaoHW" class="hero-btn hero-btn--ghost" target="_blank" rel="noopener noreferrer">
          <svg class="hero-btn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.06 11.06 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.35.78 1.05.78 2.12 0 1.53-.01 2.77-.01 3.15 0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"/></svg>
          GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- Featured reading -->
  {featured.length > 0 && (
    <section class="section" id="featured">
      <div class="section-inner">
        <p class="section-label">推荐阅读</p>
        <div class="post-list">
          {featured.map((post) => <FeaturedCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Latest deep articles (max 6, excludes featured to avoid duplication) -->
  <section class="section" id="latest">
    <div class="section-inner">
      <p class="section-label">
        近期更新
        <a href="/blog/" class="see-all">查看全部 →</a>
      </p>
      <div class="post-list">
        {latest.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <!-- Paper radar (latest issue only) -->
  {latestPaper && (
    <section class="section" id="papers">
      <div class="section-inner">
        <p class="section-label">
          每日论文雷达
          <a href="/papers/" class="see-all">历史日报 →</a>
        </p>
        <PaperDigestCard paper={latestPaper} />
        <p style="margin-top:16px;font-size:13px;color:var(--text-muted);font-family:var(--font-display);">
          每日 AI Infra / Algorithms / Architecture 三频道自动抓取,score≥4 论文精选。
        </p>
      </div>
    </section>
  )}

  <!-- Books -->
  <section class="section" id="books">
    <div class="section-inner">
      <p class="section-label">电子书</p>
      <div class="post-list">
        {books.map((book) => <BookCard book={book} />)}
      </div>
    </div>
  </section>

  <!-- Topics -->
  <section class="section" id="topics">
    <div class="section-inner">
      <p class="section-label">按主题探索</p>
      <div class="topic-grid">
        {topicCounts.map(({ topic, count }) => (
          <TopicChip slug={topic.slug} label={topic.label} count={count} description={topic.description} />
        ))}
      </div>
    </div>
  </section>

  <!-- Minor content (interviews + travel, compact; travel de-prioritized) -->
  <section class="section" id="more">
    <div class="section-inner">
      <p class="section-label">更多内容</p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:32px;">
        <div id="interview">
          <p style="font-family:var(--font-display);font-size:14px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:14px;">面经</p>
          <div class="post-list">
            {interviews.map((i) => (
              <a class="card" href={`/blog/${i.data.slug}/`} data-type="面经" style="padding:16px 20px;">
                <span class="card-title" style="font-size:16px;">{i.data.title}</span>
                <span class="card-meta"><span>{i.data.publishedDate}</span></span>
              </a>
            ))}
          </div>
        </div>
        <div id="travel">
          <p style="font-family:var(--font-display);font-size:14px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:14px;">旅行</p>
          <div class="post-list">
            {travelGuides.slice(0, 3).map((t) => (
              <a class="card" href={`/travel/${t.data.slug}.html`} data-type="旅行" style="padding:16px 20px;">
                <span class="card-title" style="font-size:16px;">{t.data.title}</span>
                <span class="card-meta"><span>{t.data.publishedDate}</span></span>
              </a>
            ))}
            {travelGuides.length > 3 && (
              <a href="/#travel" class="see-all" style="display:inline-block;margin-top:12px;font-size:13px;color:var(--orange);">查看全部旅行 →</a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
