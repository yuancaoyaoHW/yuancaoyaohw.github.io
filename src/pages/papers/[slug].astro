---
/**
 * /papers/[slug]/ — unified daily paper digest detail page.
 *
 * Renders from structured JSON (src/articles/papers/<slug>/papers.json)
 * via PaperDetailLayout + the PaperDigest* components. The layout owns the
 * single page header — no full standalone HTML is injected, no regex body
 * extraction, no duplicate Hero / title / stats.
 *
 * getStaticPaths feeds every paper in the collection; the JSON digest is
 * loaded per-slug at build time (null-safe: a missing digest renders a
 * graceful placeholder).
 */
import { getPapers, type Paper } from '../../data/content.ts';
import PaperDetailLayout from '../../layouts/PaperDetailLayout.astro';
import { loadDigest, type PaperDigest } from '../../components/papers/paper-types';

export async function getStaticPaths() {
  const papers = await getPapers();
  return papers.map((paper) => ({
    params: { slug: paper.data.slug },
    props: { paper },
  }));
}

interface Props { paper: Paper }
const { paper } = Astro.props;
const digest: PaperDigest | null = await loadDigest(paper.data.slug);
---

<PaperDetailLayout paper={paper} digest={digest} />
