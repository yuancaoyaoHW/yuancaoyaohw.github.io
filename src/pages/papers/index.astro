---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaperDigestCard from '../../components/PaperDigestCard.astro';
import { getPapers } from '../../data/content.ts';

const papers = await getPapers();
const latest = papers[0];
---
<BaseLayout
  pageType="papers"
  title="每日论文"
  description="AI Infra / Algorithms / Architecture 三频道每日论文精选归档。"
  canonical="/papers/"
>
  <section class="archive-hero">
    <div class="section-inner">
      <span class="eyebrow">Daily Papers · {papers.length} 期</span>
      <h1>每日论文雷达</h1>
      <p class="archive-lede">AI Infra / Algorithms / Architecture 三频道自动抓取与评审,每日精选 score≥4 的论文。</p>
    </div>
  </section>

  <section class="section" style="padding-top:32px;">
    <div class="section-inner">
      <!-- Latest issue highlighted -->
      {latest && (
        <>
          <p class="section-label">最新一期</p>
          <PaperDigestCard paper={latest} />
        </>
      )}

      <!-- Full archive -->
      <p class="section-label" style="margin-top:48px;">历史日报</p>
      <div class="post-list">
        {papers.map((p) => <PaperDigestCard paper={p} compact />)}
      </div>
    </div>
  </section>
</BaseLayout>
