---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOPICS, getPostsForTopic } from '../../data/content.ts';

const topicData = await Promise.all(
  TOPICS.map(async (t) => ({ topic: t, count: (await getPostsForTopic(t)).length }))
);
---
<BaseLayout
  pageType="topics"
  title="主题"
  description="按技术主题浏览：LLM Serving、Speculative Decoding、KV Cache、GPU、MoE 等。"
  canonical="/topics/"
>
  <section class="hero" style="padding-top:calc(var(--nav-h) + 48px);padding-bottom:32px;">
    <div class="hero-inner">
      <span class="eyebrow">Topics · {TOPICS.length} 个主题</span>
      <h1>按<span class="accent">主题</span>探索</h1>
      <p class="lede">不只是按时间线浏览。每个主题汇集相关深度文章、论文日报与电子书章节,并给出推荐阅读顺序。</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="section-inner">
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
        {topicData.map(({ topic, count }) => (
          <a class="card" href={`/topics/${topic.slug}/`} style="padding:24px;">
            <span class="tag">{count} 篇</span>
            <span class="card-title">{topic.label}</span>
            <span class="card-desc">{topic.description}</span>
            <span class="go">进入主题 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
