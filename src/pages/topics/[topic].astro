---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { TOPICS, getPostsForTopic, getPapersForTopic, getBookChaptersForTopic, type Topic } from '../../data/content.ts';

export async function getStaticPaths() {
  return TOPICS.map((t) => ({ params: { topic: t.slug }, props: { topic: t } }));
}

interface Props { topic: Topic; }
const { topic } = Astro.props;
const posts = await getPostsForTopic(topic);
const relatedPapers = await getPapersForTopic(topic, 3);
const bookChapters = await getBookChaptersForTopic(topic);

const featured = posts.filter((p) => p.data.featured);
const deep = posts.filter((p) => !p.data.featured);
---
<BaseLayout
  pageType="topics"
  title={topic.label}
  description={topic.description}
  canonical={`/topics/${topic.slug}/`}
>
  <section class="hero" style="padding-top:calc(var(--nav-h) + 48px);padding-bottom:32px;">
    <div class="hero-inner">
      <span class="eyebrow">Topic · {posts.length} 篇文章</span>
      <h1>{topic.label}</h1>
      <p class="lede">{topic.description}</p>
      <div class="hero-actions" style="margin-top:24px;">
        <a href="/blog/" class="btn btn-ghost">全部文章</a>
        <a href="/topics/" class="btn btn-ghost">所有主题</a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:32px;">
    <div class="section-inner narrow">
      <p class="section-label">主题介绍</p>
      <div style="font-size:16px;line-height:1.7;color:var(--text);">
        <p>{topic.description}本主题汇集相关深度文章,按入门与深入分层组织。</p>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section" style="padding-top:32px;">
      <div class="section-inner narrow">
        <p class="section-label">推荐阅读顺序</p>
        <ol style="padding-left:20px;line-height:2.2;">
          {posts.map((p) => (
            <li>
              <a href={`/blog/${p.data.slug}/`} style="color:var(--link);font-weight:600;">{p.data.title}</a>
              <span style="color:var(--text-muted);font-size:13px;"> — {p.data.publishedDate}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {featured.length > 0 && (
    <section class="section" style="padding-top:32px;">
      <div class="section-inner">
        <p class="section-label">入门文章</p>
        <div class="post-list">
          {featured.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  {deep.length > 0 && (
    <section class="section" style="padding-top:32px;">
      <div class="section-inner">
        <p class="section-label">深入文章</p>
        <div class="post-list">
          {deep.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  {relatedPapers.length > 0 && (
    <section class="section" style="padding-top:32px;">
      <div class="section-inner">
        <p class="section-label">相关论文</p>
        <div class="post-list">
          {relatedPapers.map((p) => (
            <a class="card" href={`/papers/${p.data.slug}/`}>
              <span class="tag">{p.data.selectedCount ?? '—'} 推荐</span>
              <span class="card-title">{p.data.date} 论文日报</span>
              <span class="card-desc">{p.data.description.slice(0, 140)}…</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {bookChapters.length > 0 && (
    <section class="section" style="padding-top:32px;">
      <div class="section-inner">
        <p class="section-label">电子书章节</p>
        <div class="post-list">
          {bookChapters.map((ch) => (
            <a class="card" href={ch.href}>
              <span class="tag">{ch.book}</span>
              <span class="card-title">{ch.title}</span>
              <span class="go">阅读 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section" style="padding-top:32px;">
    <div class="section-inner">
      <p class="section-label">相关主题</p>
      <div class="topic-grid">
        {TOPICS.filter((t) => t.slug !== topic.slug).map((t) => (
          <a class="topic-chip" href={`/topics/${t.slug}/`}>{t.label}</a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
