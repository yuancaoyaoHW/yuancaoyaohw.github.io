---
import type { Post } from '../data/content.ts';
import { postHref } from '../data/content.ts';

interface Props { post: Post; }
const { post } = Astro.props;
const href = postHref(post);
const tags = post.data.tags.slice(0, 3);
---
<a class="compact-row" href={href} data-type="深度文章">
  <span class="row-date">{post.data.publishedDate}</span>
  <span class="row-main">
    <span class="row-title">{post.data.title}</span>
    <span class="row-desc">{post.data.description}</span>
    <span class="row-tags">
      {tags.map((t, i) => (<>{t}{i < tags.length - 1 && <span class="tag-sep">·</span>}</>))}
    </span>
  </span>
  <span class="row-meta">{post.data.readingTime ? `${post.data.readingTime} min` : ''}</span>
</a>
