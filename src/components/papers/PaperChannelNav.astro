---
/**
 * PaperChannelNav.astro — sticky-ish channel filter chips for the digest.
 * Clicking a chip scrolls to that channel group. Pure anchor navigation,
 * works without JS.
 */
import type { PaperDigest } from './paper-types';

interface Props {
  digest: PaperDigest;
}
const { digest } = Astro.props;
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

{digest.channelGroups.length > 1 && (
  <nav class="digest-channel-nav" aria-label="方向筛选">
    {digest.channelGroups.map((g) => (
      <a class="digest-chip" href={`#channel-${slug(g.channel)}`} data-channel={g.channel}>
        {g.channel}<span class="digest-chip-count">{g.papers.length}</span>
      </a>
    ))}
  </nav>
)}
