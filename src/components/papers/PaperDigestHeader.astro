---
/**
 * PaperDigestHeader.astro — the single, canonical page header for a daily
 * paper digest. Renders breadcrumb, eyebrow, the one true <h1>, a ≤2-line
 * lede, and the stat triplet. No duplicate Hero / title / stats downstream.
 */
import type { PaperDigest } from './paper-types';

interface Props {
  digest: PaperDigest;
}
const { digest } = Astro.props;
const { date, lede, stats } = digest;
// 2026-07-30 -> 2026 年 7 月 30 日
const ymd = date.split('-');
const dateZh = `${ymd[0]} 年 ${Number(ymd[1])} 月 ${Number(ymd[2])} 日`;
---

<nav class="digest-breadcrumb" aria-label="面包屑">
  <a href="/">首页</a><span class="sep">/</span>
  <a href="/papers/">每日论文</a><span class="sep">/</span>
  <span class="current">{date}</span>
</nav>

<header class="digest-page-header">
  <p class="digest-eyebrow">每日论文 · {date}</p>
  <h1>{dateZh}论文精选</h1>
  <p class="digest-lede">{lede}</p>

  <dl class="digest-stats">
    <div>
      <dt>精选论文</dt>
      <dd>{stats.selected}</dd>
    </div>
    <div>
      <dt>研究方向</dt>
      <dd>{stats.channels}</dd>
    </div>
    <div>
      <dt>候选论文</dt>
      <dd>{stats.candidates}</dd>
    </div>
  </dl>
</header>
