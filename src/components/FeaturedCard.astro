---
import type { Post } from '../data/content.ts';
import { postHref } from '../data/content.ts';

interface Props { post: Post; }
const { post } = Astro.props;
const href = postHref(post);
const tags = post.data.tags.slice(0, 3).join(' · ');
---
<a class="card featured-card" href={href} data-type="深度文章">
  <span class="tag">★ 精选 · {tags}</span>
  <span class="card-title">{post.data.title}</span>
  <span class="card-desc">{post.data.description}</span>
  <span class="go">
    开始阅读
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
  </span>
</a>

<style>
  .featured-card { padding: 28px 32px; }
  .featured-card .tag { background: var(--orange); color: #fff; }
</style>
