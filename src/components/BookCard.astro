---
import type { Book } from '../data/content.ts';

interface Props { book: Book; }
const { book } = Astro.props;
const statusLabel = book.data.status === 'complete' ? '完结' : book.data.status === 'stub' ? '占位' : '连载中';
---
<a class="card book-card" href={book.data.href} data-type="电子书">
  <span class="tag">{book.data.tag}</span>
  <span class="card-title">{book.data.title}</span>
  <span class="card-desc">{book.data.description}</span>
  <span class="card-meta">
    <span>{statusLabel}</span>
    {book.data.chapters && book.data.chapters > 0 && (<><span class="meta-sep">·</span><span>{book.data.chapters} 章</span></>)}
    {book.data.external && <><span class="meta-sep">·</span><span>外部站</span></>}
  </span>
</a>

<style>
  .book-card { padding: 20px 24px; }
</style>
