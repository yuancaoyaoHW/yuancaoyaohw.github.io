---
import type { Post } from '../data/content.ts';
import { postHref } from '../data/content.ts';

interface Props { post: Post; }
const { post } = Astro.props;
const href = postHref(post);
const tags = post.data.tags.slice(0, 3).join(' · ');
---
<a class="card" href={href} data-type="深度文章">
  <span class="tag">{tags || post.data.category}</span>
  <span class="card-title">{post.data.title}</span>
  <span class="card-desc">{post.data.description}</span>
  <span class="card-meta">
    <span>{post.data.publishedDate}</span>
    {post.data.updatedDate && (<><span class="meta-sep">·</span><span>更新 {post.data.updatedDate}</span></>)}
    {post.data.readingTime && (<><span class="meta-sep">·</span><span>{post.data.readingTime} min</span></>)}
  </span>
</a>
