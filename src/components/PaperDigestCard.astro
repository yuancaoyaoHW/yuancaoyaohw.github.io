---
import type { Paper } from '../data/content.ts';
import { paperHref } from '../data/content.ts';

interface Props { paper: Paper; compact?: boolean; }
const { paper, compact = false } = Astro.props;
const href = paperHref(paper);
const sel = paper.data.selectedCount ?? 0;
const stats = sel > 0
  ? `${sel} 推荐 · ${paper.data.channels.length} 频道`
  : '周日占位';
---
<a class="card" href={href} data-type="论文日报">
  <span class="tag">{stats}</span>
  <span class="card-title">{paper.data.date}</span>
  {!compact && <span class="card-desc">{paper.data.description}</span>}
  {!compact && paper.data.highlights.length > 0 && (
    <span class="card-meta">
      最值得关注：
      {paper.data.highlights.map((h, i) => (<><span style="color:var(--orange)">{h.name}</span>{i < paper.data.highlights.length - 1 && <span class="meta-sep">·</span>}</>))}
    </span>
  )}
  <span class="date">{paper.data.date}</span>
</a>
