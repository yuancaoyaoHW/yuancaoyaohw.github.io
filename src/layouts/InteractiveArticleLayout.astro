---
import BaseLayout from './BaseLayout.astro';
import { type Post, type Interview } from '../data/content.ts';

export interface Props {
  /** posts 与 interviews 两个集合的字段形状在这里用到的部分一致，故同一布局通用 */
  post: Post | Interview;
  headHtml?: string;
  bodyHtml?: string;
  /** 面包屑第二级与「返回」目标，面经页指向自己的归档语义 */
  parentLabel?: string;
  parentHref?: string;
  activeMore?: string;
}

const { post, headHtml, bodyHtml, parentLabel = '深度文章', parentHref = '/blog/', activeMore } = Astro.props;
const d = post.data as {
  title: string; description: string; slug: string;
  publishedDate: string; updatedDate?: string;
};
const SITE = 'https://yuancaoyaohw.github.io';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.publishedDate,
  dateModified: d.updatedDate || d.publishedDate,
  author: { '@type': 'Person', name: 'yuancaoyaohw', url: 'https://github.com/yuancaoyaoHW' },
  mainEntityOfPage: `${SITE}/blog/${d.slug}/`,
};
---
<BaseLayout
  pageType="blog"
  title={d.title}
  description={d.description}
  canonical={`/blog/${d.slug}/`}
  ogType="article"
  publishedDate={d.publishedDate}
  updatedDate={d.updatedDate}
  activeMore={activeMore}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {headHtml && <Fragment set:html={headHtml} />}
  </Fragment>

  <nav class="interactive-breadcrumb" aria-label="面包屑">
    <a href="/">首页</a><span class="sep">/</span>
    <a href={parentHref}>{parentLabel}</a><span class="sep">/</span>
    <span class="current">{d.title}</span>
  </nav>

  <div class="interactive-body" set:html={bodyHtml} />

  <div class="back-to-archive">
    <a href={parentHref}>← 返回{parentLabel}</a>
  </div>

  <style is:global>
    .interactive-breadcrumb { max-width: var(--content-w); margin: 0 auto; padding: calc(var(--nav-h) + 16px) 24px 8px; font-family: var(--font-display); font-size: 13px; color: var(--text-muted); display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .interactive-breadcrumb a:hover { color: var(--link); }
    .interactive-breadcrumb .sep { opacity: 0.4; }
    .interactive-breadcrumb .current { color: var(--text); }
    .interactive-body { position: relative; z-index: 1; }
    .interactive-body :where(svg, img, pre, table) { max-width: 100%; }
    .interactive-body pre { overflow-x: auto; }
    .interactive-body table { display: block; overflow-x: auto; max-width: 100%; }
    .back-to-archive { max-width: var(--content-w); margin: 0 auto; text-align: center; padding: 24px; border-top: 1px solid var(--border); }
    .back-to-archive a { font-family: var(--font-display); font-size: 14px; color: var(--link); }
    .back-to-archive a:hover { text-decoration: underline; }
  </style>
</BaseLayout>
